{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    },
    {
      "source": "/product/:slug",
      "destination": "/products/:slug",
      "statusCode": 308,
      "regex": "^(?!/_next)/product(?:/([^/]+?))(?:/)?$"
    },
    {
      "source": "/product-category/jacket/mens-jacket",
      "destination": "/collections/mens-jacket",
      "statusCode": 308,
      "regex": "^(?!/_next)/product-category/jacket/mens-jacket(?:/)?$"
    },
    {
      "source": "/product-category/jacket/womens-jacket",
      "destination": "/collections/womens-jacket",
      "statusCode": 308,
      "regex": "^(?!/_next)/product-category/jacket/womens-jacket(?:/)?$"
    },
    {
      "source": "/product-category/jacket",
