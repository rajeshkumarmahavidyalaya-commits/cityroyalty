    },
    {
      "source": "/blog",
      "destination": "/journal",
      "statusCode": 308,
      "regex": "^(?!/_next)/blog(?:/)?$"
    },
    {
      "source": "/types-of-leather",
      "destination": "/journal/types-of-leather",
      "statusCode": 308,
      "regex": "^(?!/_next)/types-of-leather(?:/)?$"
    },
    {
      "source": "/leather-care",
      "destination": "/journal/leather-care",
      "statusCode": 308,
      "regex": "^(?!/_next)/leather-care(?:/)?$"
    },
    {
      "source": "/how-to-spot-fake-leather",
      "destination": "/journal/how-to-spot-fake-leather",
      "statusCode": 308,
      "regex": "^(?!/_next)/how-to-spot-fake-leather(?:/)?$"
