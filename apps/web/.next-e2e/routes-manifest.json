    },
    {
      "source": "/sponsoring-photography-with-poi",
      "destination": "/journal/sponsoring-photography-with-poi",
      "statusCode": 308,
      "regex": "^(?!/_next)/sponsoring-photography-with-poi(?:/)?$"
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(self \"https://checkout.razorpay.com\" \"https://js.stripe.com\")"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ],
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    },
    {
      "source": "/models/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ],
      "regex": "^/models(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    }
  ],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [
      {
        "source": "/api/v1/:path*",
        "destination": "http://localhost:4100/api/v1/:path*",
        "regex": "^/api/v1(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
      },
      {
        "source": "/media/:path*",
        "destination": "http://localhost:4100/media/:path*",
        "regex": "^/media(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
      }
    ],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/account/orders/[number]",
      "regex": "^/account/orders/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPnumber": "nxtPnumber"
      },
      "namedRegex": "^/account/orders/(?<nxtPnumber>[^/]+?)(?:/)?$"
    },
    {
      "page": "/collections/[slug]",
      "regex": "^/collections/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/collections/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/journal/[slug]",
