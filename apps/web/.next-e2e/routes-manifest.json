      "statusCode": 308,
      "regex": "^(?!/_next)/about-us-2(?:/)?$"
    },
    {
      "source": "/refund_returns",
      "destination": "/pages/refund-and-returns",
      "statusCode": 308,
      "regex": "^(?!/_next)/refund_returns(?:/)?$"
    },
    {
