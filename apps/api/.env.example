# ---- core ----
NODE_ENV=development
PORT=4000
# Postgres. Locally: `npm run dev:db` starts one on 54329 (this default). On Supabase use the transaction pooler (port 6543).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/cityroyalty
DB_POOL_MAX=10                  # use 1 on serverless (Vercel)
# ...or, instead of DATABASE_URL, the parts (then only DB_PASSWORD is a secret):
# DB_HOST=aws-1-ap-south-1.pooler.supabase.com  DB_PORT=6543  DB_USER=cr_api.<project-ref>  DB_NAME=postgres  DB_PASSWORD=
RUN_MIGRATIONS=true             # apply drizzle/ migrations on boot (set false where migrations run separately)
# REQUIRED in production: 32+ random chars (openssl rand -base64 48). In development a random one is generated per boot.
JWT_SECRET=
# Comma-separated browser origins allowed to call the API directly (the Next apps normally proxy /api so this is a fallback)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
PUBLIC_WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
TRUST_PROXY=0

# ---- media ----
STORAGE_DRIVER=local            # local | s3 | supabase
STORAGE_LOCAL_DIR=./storage
PUBLIC_MEDIA_URL=/media         # absolute CDN base in production, e.g. https://cdn.cityroyalty.in
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=                    # R2 / MinIO endpoint (optional for AWS)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# supabase driver: uploads go through the media-upload Edge Function (it holds the service key, never this API)
SUPABASE_MEDIA_UPLOAD_URL=      # https://<project>.supabase.co/functions/v1/media-upload
SUPABASE_MEDIA_TOKEN=           # shared secret the function checks (it stores only its SHA-256)

# ---- payments (leave blank to disable a provider) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Fake provider for development/tests ONLY. Refused when NODE_ENV=production.
PAYMENT_MOCK_ENABLED=true
MOCK_WEBHOOK_SECRET=

# ---- email ----
SMTP_URL=                       # smtps://user:pass@smtp.example.com:465 ; blank = log emails to console
MAIL_FROM="City Royalty <orders@cityroyalty.in>"

# ---- cache revalidation (storefront) ----
REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=
