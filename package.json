{
  "name": "cityroyalty",
  "private": true,
  "version": "2.0.0",
  "description": "City Royalty — premium leather e-commerce platform (storefront, admin, API)",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=20.11" },
  "scripts": {
    "dev:api": "npm run dev -w @cityroyalty/api",
    "dev:web": "npm run dev -w @cityroyalty/web",
    "dev:admin": "npm run dev -w @cityroyalty/admin",
    "build": "npm run build -w @cityroyalty/api && npm run build -w @cityroyalty/web && npm run build -w @cityroyalty/admin",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "showcase": "npm run build -w @cityroyalty/showcase"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
